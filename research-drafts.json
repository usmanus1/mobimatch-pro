import datetime
import json
import re
import xml.etree.ElementTree as ET
import requests

TODAY = datetime.date.today().isoformat()
HEADERS = {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/128.0.0.0 Safari/537.36"
}

# 1. Update sitemap.xml <lastmod> dates
try:
    with open("sitemap.xml", "r", encoding="utf-8") as f:
        xml = f.read()
    updated_xml = re.sub(r"<lastmod>.*?</lastmod>", f"<lastmod>{TODAY}</lastmod>", xml)
    with open("sitemap.xml", "w", encoding="utf-8") as f:
        f.write(updated_xml)
    print(f"✅ sitemap.xml updated to {TODAY}")
except Exception as e:
    print(f"⚠️ Sitemap skipped: {e}")

# 2. Fetch latest mobile releases using built-in XML parser + browser User-Agent
FEEDS = [
    "https://www.gsmarena.com/rss-news-reviews.php3",
    "https://www.gizmochina.com/feed/"
]
BRANDS = ["samsung", "galaxy", "xiaomi", "redmi", "poco", "vivo", "iqoo", "oppo", "realme", "oneplus", "infinix", "tecno", "itel", "iphone", "motorola", "moto", "honor", "huawei", "pixel"]

drafts = []
seen = set()

for feed_url in FEEDS:
    try:
        res = requests.get(feed_url, headers=HEADERS, timeout=15)
        res.raise_for_status()
        root = ET.fromstring(res.content)
        for item in root.findall(".//item")[:15]:
            title = (item.findtext("title") or "").strip()
            link = (item.findtext("link") or "").strip()
            if title and title not in seen and any(b in title.lower() for b in BRANDS):
                seen.add(title)
                drafts.append({
                    "date": TODAY,
                    "headline": title,
                    "source": link,
                    "status": "Pending Bench Verification"
                })
        if len(drafts) >= 10:
            break
    except Exception as e:
        print(f"⚠️ Feed error ({feed_url}): {e}")

with open("research-drafts.json", "w", encoding="utf-8") as f:
    json.dump({"last_sync": TODAY, "leads": drafts[:12]}, f, indent=2)
print(f"✅ Saved {len(drafts[:12])} new model research leads to research-drafts.json")
