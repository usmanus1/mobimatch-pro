{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "mobimatchpro.com" }],
      "destination": "https://www.mobimatchpro.com/:path*",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "https://www.mobimatchpro.com/",
      "permanent": true
    },
    {
      "source": "/privacy.html",
      "destination": "https://www.mobimatchpro.com/privacy",
      "permanent": true
    },
    {
      "source": "/about.html",
      "destination": "https://www.mobimatchpro.com/about",
      "permanent": true
    },
    {
      "source": "/contact.html",
      "destination": "https://www.mobimatchpro.com/contact",
      "permanent": true
    }
  ]
}
